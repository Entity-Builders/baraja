{
  "name": "baraja",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Baraja.cards — Digital Spanish card decks with printable PDF companions.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "test:design-pipeline": "tsx scripts/deckDesignPipeline.test.ts",
    "test:music-bingo:creator-flow": "tsx scripts/musicBingoCreatorFlow.test.ts",
    "test:acquisition-attribution": "tsx scripts/acquisitionAttribution.test.ts",
    "test:spotify-seed": "tsx scripts/spotifySeedPayload.test.ts",
    "check:music-bingo:collections": "tsx scripts/seedMusicBingoCollections.ts --check",
    "clean:spotify-playlist:duplicates": "tsx scripts/cleanSpotifyPlaylistDuplicates.ts",
    "seed:music-bingo:collections": "tsx scripts/seedMusicBingoCollections.ts",
    "sync:music-bingo:catalog": "tsx scripts/seedMusicBingoCollections.ts --sync-catalog --all",
    "preview": "npm run build && wrangler dev",
    "deploy:prod": "npm run build && wrangler deploy --env production",
    "db:migrate": "wrangler d1 execute baraja-db --file=migrations/0001_initial.sql",
    "db:migrate:remote": "wrangler d1 execute baraja-db --remote --file=migrations/0001_initial.sql",
    "db:migrate:catalog": "wrangler d1 execute baraja-db --file=migrations/0002_deck_catalog.sql",
    "db:migrate:catalog:remote": "wrangler d1 execute baraja-db --remote --file=migrations/0002_deck_catalog.sql",
    "db:migrate:music-bingo-catalog": "wrangler d1 execute baraja-db --file=migrations/0003_music_bingo_collections.sql",
    "db:migrate:music-bingo-catalog:remote": "wrangler d1 execute baraja-db --remote --file=migrations/0003_music_bingo_collections.sql",
    "db:seed:decks:sql": "tsx scripts/generate_d1_deck_seed.ts",
    "db:seed:supabase": "tsx scripts/seed_decks.ts",
    "db:seed:supabase:prod": "BARAJA_DB_TARGET=production tsx scripts/seed_decks.ts"
  },
  "dependencies": {
    "@entity-builders/analytics": "^1.0.0",
    "@entity-builders/app-registry": "^0.1.0",
    "@entity-builders/billing-core": "^0.1.0",
    "@entity-builders/deck-engine": "^0.1.0",
    "@entity-builders/spotify-service": "^0.1.0",
    "@entity-builders/ui-web": "^0.1.0",
    "@pdfme/common": "^6.0.6",
    "@pdfme/generator": "^6.0.6",
    "@pdfme/schemas": "^6.0.6",
    "@pdfme/ui": "^6.0.6",
    "buffer": "^6.0.3",
    "pdfjs-dist": "^5.6.205",
    "qrcode.react": "^4.2.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-router-dom": "^7.13.1",
    "simple-icons": "^16.25.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.28.0",
    "@cloudflare/workers-types": "^4.20250620.0",
    "@eslint/js": "^9.39.4",
    "@supabase/supabase-js": "^2.101.1",
    "@types/node": "^24.12.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "dotenv": "^17.4.0",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.4.0",
    "tsx": "^4.21.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.57.0",
    "vite": "^8.0.1",
    "wrangler": "^4.77.0"
  },
  "packageManager": "yarn@4.13.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/Entity-Builders/baraja.git"
  }
}
